<div class="author">
    <h1 class="author__heading">Hi,I am Asrith</h1>
    <p class="author__body">Web developer and content creator</p>
</div>
 <img src="/images/hero-image.webp" alt="person looking out through window" class="hero-image" width="981" height="528">

 <section class="articles">
   <h2 class="articles__heading">Latest Posts</h2>

   <section class="article-section">

    <% data.forEach(post => { %>
     
   
     <div>
      <img src="<%= post.image%>" alt="" class="home__images">
        <a href="/post/<%=post._id %>">
            <span class="post_title"><%=post.title %></span>
            <p class="post_body"><%= post.body %></p>
            <span class="article-list__date"><%=post.createdAt.toDateString() %></span>
        </a>
     </div>

      <% }) %>

   </section>
   <% if (nextPage !== null) { %>
    <a href="/?page=<%= nextPage %>" class="pagination">&lt; View Older Posts</a>
   <% } %>
   
 </section>