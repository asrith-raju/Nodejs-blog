<a href="/dashboard">&larr; Back</a>
<div class="admin-title">
    <h2>Add New Post</h2>
</div>

<form action="/add-post" method="POST">

  <label for="title"><b>Title</b></label>
  <input type="text" placeholder="Post Title" name="title">
  <label for="body"><b>Content</b></label>
  <textarea name="body" cols="50" rows="10"></textarea>
<h3>Select Category Image</h3>
  <div class="categories">
    <% images.forEach(image => { %>
  <div class="category">
    <img src="/images/categories/<%= image %>" class="cateimg"  alt="category">
    <p class="imagetext">+</p>
       <input type="radio" name="categoryImage" value="/images/categories/<%= image %>" hidden>
  </div>
<% }) %>

  </div>
  
  <input type="submit" value="Add" class="btn">
</form>
<script>
  const categories = document.querySelectorAll('.category');

  categories.forEach(category => {
    const radio = category.querySelector('input[type="radio"]');
    category.addEventListener('click', () => {
      categories.forEach(c => c.querySelector('input[type="radio"]').checked = false);
      categories.forEach(c => c.classList.remove('selected'));
      radio.checked = true;
      category.classList.add('selected');
    });
  });
</script>